            "method": "GET",
            "url": "{{api_url}}/products?limit=20&offset=0&sort_by=created_at&sort_dir=desc"
          }
        },
        {
          "name": "Search products by keyword",
          "request": {
            "method": "GET",
            "url": "{{api_url}}/products?keyword=kim"
          }
        },
        {
          "name": "Get product by id (public)",
          "request": {
            "method": "GET",
            "url": "{{api_url}}/products/{{product_id}}"
          }
        },
        {
          "name": "Create product + variant (admin/staff)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const data = pm.response.json();",
                  "  pm.collectionVariables.set('product_id', data.id);",
                  "  if (data.variants && data.variants.length) {",
                  "    pm.collectionVariables.set('variant_id', data.variants[0].id);",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{api_url}}/products",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"category_id\": {{category_id}},\n  \"sku\": \"SACH-900\",\n  \"name\": \"Sách Test Postman\",\n  \"author\": \"Tac gia Demo\",\n  \"base_price\": 99000,\n  \"variants\": [\n    { \"variant_name\": \"Bìa mềm\", \"sku\": \"SACH-900-BM\", \"initial_quantity\": 30, \"reorder_level\": 5 }\n  ]\n}"
            }
          }
        },
        {
          "name": "Update product (admin/staff)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{api_url}}/products/{{product_id}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"base_price\": 105000\n}"
            }
          }
        },
        {
          "name": "Delete product (admin/staff, soft-delete)",
          "request": {
            "method": "DELETE",
            "url": "{{api_url}}/products/{{product_id}}"
          }
        },
        {
          "name": "Add variant to product (admin/staff)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{api_url}}/products/{{product_id}}/variants",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"variant_name\": \"Bìa cứng\",\n  \"sku\": \"SACH-900-BC\",\n  \"price_adjustment\": 25000,\n  \"initial_quantity\": 15,\n  \"reorder_level\": 3\n}"
            }
          }
        },
        {
          "name": "Update variant (admin/staff)",
