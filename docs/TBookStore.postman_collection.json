{
  "info": {
    "name": "TBookStore API — Sprint 1-4 (đầy đủ)",
    "description": "Collection test tay Sprint 1-4 day du: auth/JWT/RBAC, danh muc/san pham/kho/nhan su (Sprint 1-2), gio hang/checkout/don hang/khuyen mai/tra hang/danh gia (Sprint 3), thong ke/bao cao PDF/celery/bao mat (Sprint 4). Chay 'Login - Admin' va 'Login - Customer' truoc; request Admin/Staff dung {{access_token}} qua collection-level auth, request rieng cho khach hang (gio hang/checkout/danh gia/tra hang) tu override sang {{customer_access_token}}.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000"
    },
    {
      "key": "api_url",
      "value": "{{base_url}}/api/v1"
    },
    {
      "key": "access_token",
      "value": ""
    },
    {
      "key": "refresh_token",
      "value": ""
    },
    {
      "key": "staff_access_token",
      "value": ""
    },
    {
      "key": "category_id",
      "value": "1"
    },
    {
      "key": "supplier_id",
      "value": "1"
    },
    {
      "key": "product_id",
      "value": "1"
    },
    {
      "key": "variant_id",
      "value": "1"
    },
    {
      "key": "staff_id",
      "value": "1"
    },
    {
      "key": "import_lot_id",
      "value": "1"
    },
    {
      "key": "customer_access_token",
      "value": ""
    },
    {
      "key": "address_id",
      "value": "1"
    },
    {
      "key": "promotion_id",
      "value": "1"
    },
    {
      "key": "flash_promotion_id",
      "value": "2"
    },
    {
      "key": "order_id",
      "value": "1"
    },
    {
      "key": "order_item_id",
      "value": "1"
    },
    {
      "key": "refund_request_id",
      "value": "1"
    },
    {
      "key": "report_task_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/health"
          }
        },
        {
          "name": "Health check DB",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/health/db"
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register (customer)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{api_url}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"customer1@tbookstore.vn\",\n  \"password\": \"Customer@123\",\n  \"full_name\": \"Khach Hang A\",\n  \"phone\": \"0911111111\"\n}"
            }
          }
        },
        {
          "name": "Login - Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const data = pm.response.json();",
                  "pm.collectionVariables.set('access_token', data.access_token);",
                  "pm.collectionVariables.set('refresh_token', data.refresh_token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{api_url}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@tbookstore.vn\",\n  \"password\": \"Admin@123\"\n}"
            }
          }
        },
        {
          "name": "Login - Customer",
          "request": {
            "method": "POST",
            "url": "{{api_url}}/auth/login",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"customer@tbookstore.vn\",\n  \"password\": \"Customer@123\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const data = pm.response.json();",
                  "pm.collectionVariables.set('customer_access_token', data.access_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login - Staff",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const data = pm.response.json();",
                  "pm.collectionVariables.set('staff_access_token', data.access_token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{api_url}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"staff@tbookstore.vn\",\n  \"password\": \"Staff@123\"\n}"
            }
          }
        },
        {
          "name": "Refresh token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const data = pm.response.json();",
                  "pm.collectionVariables.set('access_token', data.access_token);",
                  "pm.collectionVariables.set('refresh_token', data.refresh_token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{api_url}}/auth/refresh",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refresh_token}}\"\n}"
            }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{api_url}}/auth/logout",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refresh_token}}\"\n}"
            }
          }
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "url": "{{api_url}}/auth/me"
          }
        }
      ]
    },
